{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Aircraft 启动与首启流程",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "app",
      "label": "应用进程"
    },
    {
      "id": "gates",
      "label": "合规闸门"
    },
    {
      "id": "hub",
      "label": "启动中枢"
    },
    {
      "id": "game",
      "label": "战斗场景"
    },
    {
      "id": "forced",
      "label": "版本强制更新",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "init",
      "label": "进程初始化",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "firstrun",
      "label": "首启闸门",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "combat",
      "label": "进入战斗",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "groups": [
    {
      "id": "gates_group",
      "label": "已同意则跳过",
      "lane": "gates",
      "fromCol": 1,
      "toCol": 3,
      "variant": "default"
    },
    {
      "id": "forced_group",
      "label": "版本不满足最低要求",
      "lane": "forced",
      "fromCol": 0,
      "toCol": 3,
      "variant": "security"
    }
  ],
  "mainPath": [
    "app_init",
    "privacy",
    "onboarding",
    "launch",
    "main",
    "core"
  ],
  "nodes": [
    {
      "id": "app_init",
      "lane": "app",
      "col": 0,
      "type": "backend",
      "label": "进程初始化",
      "sublabel": "日志 / 远程配置"
    },
    {
      "id": "privacy",
      "lane": "gates",
      "col": 1,
      "type": "frontend",
      "label": "隐私政策",
      "sublabel": "未同意拦截"
    },
    {
      "id": "onboarding",
      "lane": "gates",
      "col": 3,
      "type": "frontend",
      "label": "新手指引",
      "sublabel": "已读跳过"
    },
    {
      "id": "launch",
      "lane": "hub",
      "col": 4,
      "type": "frontend",
      "label": "启动中枢",
      "sublabel": "继续 / 新局"
    },
    {
      "id": "main",
      "lane": "hub",
      "col": 5,
      "type": "frontend",
      "label": "主界面",
      "sublabel": "Compose"
    },
    {
      "id": "core",
      "lane": "game",
      "col": 5,
      "type": "backend",
      "label": "渲染线程",
      "sublabel": "30 FPS 帧循环"
    },
    {
      "id": "rc_fetch",
      "lane": "forced",
      "col": 0,
      "type": "cloud",
      "label": "拉取配置",
      "sublabel": "四参数 + 实时监听"
    },
    {
      "id": "version_check",
      "lane": "forced",
      "col": 2,
      "type": "security",
      "label": "版本比对",
      "sublabel": "解析失败则放行"
    },
    {
      "id": "mandatory",
      "lane": "forced",
      "col": 3,
      "type": "security",
      "label": "强制更新",
      "sublabel": "拦截返回键"
    }
  ],
  "edges": [
    {
      "id": "e_init_privacy",
      "from": "app_init",
      "to": "privacy",
      "label": "冷启动",
      "variant": "emphasis"
    },
    {
      "id": "e_privacy_onboarding",
      "from": "privacy",
      "to": "onboarding",
      "variant": "emphasis"
    },
    {
      "id": "e_onboarding_launch",
      "from": "onboarding",
      "to": "launch",
      "variant": "emphasis"
    },
    {
      "id": "e_launch_main",
      "from": "launch",
      "to": "main",
      "label": "关卡参数",
      "variant": "emphasis",
      "labelDy": -20
    },
    {
      "id": "e_main_core",
      "from": "main",
      "to": "core",
      "label": "承载 SurfaceView",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "e_init_rc",
      "from": "app_init",
      "to": "rc_fetch",
      "label": "异步拉取",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "e_rc_check",
      "from": "rc_fetch",
      "to": "version_check",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "e_check_mandatory",
      "from": "version_check",
      "to": "mandatory",
      "label": "版本过低",
      "variant": "security",
      "role": "error",
      "labelDy": -20
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "闸门只拦一次",
      "items": [
        "隐私与引导偏好落盘后，后续启动直达启动中枢",
        "BaseAircraftActivity 先初始化 ViewModel，再按 isFinishing 决定是否建 UI"
      ]
    },
    {
      "dot": "amber",
      "title": "校验发生在每次 Resume",
      "items": [
        "ActivityLifecycleCallbacks 在 onActivityResumed 复查最低版本",
        "强制更新页自行复查并吞掉返回键，不允许绕过"
      ]
    },
    {
      "dot": "cyan",
      "title": "两条线程边界",
      "items": [
        "配置拉取或解析失败一律放行，降级到内置默认值",
        "界面事件经 gameCommands 队列进入渲染线程，不直接改游戏状态"
      ]
    }
  ]
}
  "cards": [
    {
      "dot": "cyan",
      "title": "弹道实现与调节入口",
      "items": [
        "BossBomb.vx 承载水平速度，0 即旧的垂直单发",
        "Spread Shot 画红色圆球，单发仍画导弹贴图",
        "出屏判定同时检查左右，斜飞弹不会滞留",
        "圆心沿用 missileSize/2，命中判定无需改动",
        "SPREAD_HP_RATIO / _COUNT / _ANGLE / _ORB_RADIUS_RATIO 在 BossEnemy companion"
      ]
    }
  ]
}
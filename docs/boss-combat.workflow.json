      "width": 124
    },
    {
      "id": "singleShot",
      "lane": "single",
      "col": 3,
      "type": "backend",
      "label": "单发导弹",
      "sublabel": "vx = 0",
      "tag": "HP ≥ 50%"
    },
    {
      "id": "spreadShot",
      "lane": "spread",
      "col": 4,
      "type": "messagebus",
      "label": "Spread Shot",
      "sublabel": "5 发 · ±20°",
      "tag": "HP < 50%"
    },
    {
      "id": "hitBomb",
      "lane": "spread",
      "col": 5,
      "type": "security",
      "label": "玩家中弹",
      "sublabel": "护盾吸收 / 扣血"
    }

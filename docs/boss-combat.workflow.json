    {
      "id": "e-spread-hit",
      "from": "spreadShot",
      "to": "hitBomb",
      "label": "圆心落入判定框",
      "variant": "security",
      "role": "branch",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop",
      "labelDy": -14,
      "labelAt": [
        625,
        600
      ]
    },
    {
      "id": "e-explode-done",
      "from": "explode",
      "to": "levelDone",
      "label": "爆炸演出结束",
      "variant": "default"

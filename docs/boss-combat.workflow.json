      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "e-player-gate",
      "from": "playerFire",
      "to": "hpGate",
      "label": "命中扣血",
      "variant": "dashed",
      "role": "branch",
      "labelDy": 11
    },
    {
      "id": "e-gate-single",
      "from": "hpGate",
      "to": "singleShot",
      "label": "HP ≥ 50%",
      "variant": "default",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop",
      "labelDy": 11
    },
    {
      "id": "e-single-spread",
      "from": "singleShot",
      "to": "spreadShot",
      "label": "跌破阈值切换",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop",
      "labelDy": 11
    },
    {
      "id": "e-spread-explode",
      "from": "spreadShot",
      "to": "explode",

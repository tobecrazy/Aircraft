      "sublabel": "isBelowHpRatio()",
      "tag": "阈值 0.5"
    },
    {
      "id": "explode",
      "lane": "boss",
      "col": 5,
      "type": "backend",
      "label": "多阶段爆炸",
      "sublabel": "触发后 3.5s"
    },
    {
      "id": "playerFire",
      "lane": "single",
      "col": 2,
      "type": "external",
      "label": "玩家子弹 / 火箭",

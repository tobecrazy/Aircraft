    },
    {
      "id": "levelDone",
      "lane": "core",
      "col": 5,
      "type": "backend",
      "label": "关卡结算",
      "sublabel": "onLevelComplete()"
    },
    {
      "id": "fireCheck",
      "lane": "boss",
      "col": 2,
      "type": "backend",
      "label": "开火节流判定",
      "sublabel": "updateBombs()"

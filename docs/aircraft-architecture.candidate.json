{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Aircraft 应用架构",
    "quality_profile": "showcase",
    "viewBox": [2080, 1080]
  },
  "components": [
    { "id": "entry", "type": "frontend", "label": "启动入口链", "sublabel": "隐私 → 引导 → 启动大厅", "pos": [140, 80], "size": [300, 120] },
    { "id": "baseActivity", "type": "frontend", "label": "BaseAircraftActivity", "sublabel": "22 个页面里的 21 个", "pos": [140, 320], "size": [300, 120] },
    { "id": "richtext", "type": "external", "label": ":richtexteditor", "sublabel": "RichTextEditorView", "pos": [140, 560], "size": [300, 120] },
    { "id": "banner", "type": "external", "label": ":supperbanner", "sublabel": "SupperBannerView", "pos": [140, 800], "size": [300, 120] },

    { "id": "mainActivity", "type": "frontend", "label": "MainActivity", "sublabel": "Compose HUD + SurfaceView", "pos": [660, 80], "size": [300, 120] },
    { "id": "viewModels", "type": "backend", "label": "ViewModel 层", "sublabel": "StateFlow / LiveData / SharedFlow", "pos": [660, 320], "size": [300, 120] },
    { "id": "prefs", "type": "database", "label": "偏好存储", "sublabel": "SharedPreferences + DataStore", "pos": [660, 560], "size": [300, 120] },

    { "id": "gameCore", "type": "backend", "label": "GameCoreView", "sublabel": "SurfaceView · 30 FPS 渲染线程", "pos": [1180, 80], "size": [300, 120] },
    { "id": "commands", "type": "messagebus", "label": "gameCommands 队列", "sublabel": "ConcurrentLinkedQueue<() -> Unit>", "pos": [1180, 320], "size": [300, 120] },
    { "id": "stateBus", "type": "messagebus", "label": "GameStateManager", "sublabel": "MutableSharedFlow · 仅低内存事件", "pos": [1180, 560], "size": [300, 120] },

    { "id": "room", "type": "database", "label": "Room AppDatabase", "sublabel": "v2031 · 4 条显式迁移", "pos": [1700, 320], "size": [300, 120] },
    { "id": "application", "type": "security", "label": "AircraftApplication", "sublabel": "端口锁 · FLAG_SECURE", "pos": [1700, 560], "size": [300, 120] }
  ],
  "boundaries": [
    { "kind": "region", "label": "Compose / Material3 界面层", "wraps": ["entry", "mainActivity", "baseActivity"] },
    { "kind": "region", "label": "渲染线程状态边界", "wraps": ["gameCore", "commands"] },
    { "kind": "region", "label": "可复用 AAR 库", "wraps": ["richtext", "banner"] }
  ],
  "connections": [
    { "id": "launch", "from": "entry", "to": "mainActivity", "label": "首次启动 / 继续游戏" },
    { "id": "host", "from": "mainActivity", "to": "gameCore", "label": "AndroidView 承载 SurfaceView" },
    { "id": "enqueue", "from": "mainActivity", "to": "commands", "label": "入队暂停/继续/关卡推进", "fromSide": "bottom", "toSide": "left", "via": [[810, 260], [1090, 260], [1090, 380]], "labelAt": [950, 260] },
    { "id": "drain", "from": "commands", "to": "gameCore", "label": "每帧 drain，锁内执行" },
    { "id": "uiState", "from": "baseActivity", "to": "viewModels", "label": "订阅状态 / 一次性事件", "labelAt": [550, 356] },
    { "id": "useRichText", "from": "baseActivity", "to": "richtext", "label": "AndroidView 嵌入编辑器", "labelAt": [290, 500] },
    { "id": "useBanner", "from": "baseActivity", "to": "banner", "label": "AndroidView 嵌入轮播", "fromSide": "right", "toSide": "right", "via": [[520, 380], [520, 860]], "labelAt": [520, 740] },
    { "id": "readPrefs", "from": "viewModels", "to": "prefs", "label": "主题 / 安装 ID / 日志开关", "labelAt": [810, 500] },
    { "id": "save", "from": "viewModels", "to": "room", "label": "replaceForPlayer() 事务", "fromSide": "right", "toSide": "left", "via": [[1090, 380], [1090, 500], [1670, 500], [1670, 380]], "labelAt": [1380, 500] },
    { "id": "emit", "from": "application", "to": "stateBus", "label": "onLowMemory emit" },
    { "id": "lowMem", "from": "stateBus", "to": "mainActivity", "label": "LOW_MEMORY 暂停 + 遮罩", "fromSide": "bottom", "toSide": "top", "via": [[1330, 1010], [64, 1010], [64, 40], [810, 40]], "labelAt": [440, 40] }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "线程边界",
      "items": [
        "GameCoreView 用 post{} 把结算回调派发到 UI 线程，post{} 不是入队手段",
        "外部改动引擎状态一律 enqueue 到 gameCommands，由帧首 drain 执行",
        "非游戏功能没有线程约束，普通 Dispatchers.IO"
      ]
    },
    {
      "dot": "amber",
      "title": "两套状态模型不可混用",
      "items": [
        "GameCoreView 是渲染线程受限引擎，不是 MVVM 屏幕",
        "GameViewModel 只负责持久化与计分，不碰渲染循环",
        "MusicService / FlashlightService 必须比页面活得久"
      ]
    },
    {
      "dot": "emerald",
      "title": "持久化约束",
      "items": [
        "Room 没有破坏性回退：缺迁移即升级崩溃",
        "所有进度写走 replaceForPlayer() 的 @Transaction",
        "finish() 必须留在 suspend 保存之后的协程里"
      ]
    }
  ]
}

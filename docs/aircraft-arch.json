 "cards": [
  {
   "dot": "cyan",
   "title": "Two state models",
   "items": [
    "Combat is a SurfaceView 30 FPS loop, not a Compose screen",
    "MainActivity is a hybrid: Compose chrome hosts GameCoreView via AndroidView",
    "Other screens use Compose setContent; View Binding is off"
   ]
  },
  {
   "dot": "violet",
   "title": "Thread boundary and interruption shield",
   "items": [
    "Render thread owns game state; UI thread only enqueues lambdas to gameCommands",
    "Touch coordinates ride a pendingPlayerTouch atomic, latest wins per frame",
    "Resume engages DND filter NONE; pause and stop restore the previous filter",
    "Any occlusion auto-pauses combat; resume needs a manual tap"
   ]
  },
  {
   "dot": "amber",
   "title": "Persistence and module boundary",
   "items": [
    "Room v2033 registers explicit migrations only, no destructive fallback",
    "All progress goes through the replaceForPlayer transaction",
    ":developtools depends on both View libraries; the libraries avoid game and theme imports"
   ]
  }
 ]
}
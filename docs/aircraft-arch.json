  "cards": [
    {
      "dot": "cyan",
      "title": "表现与线程",
      "items": [
        "全部 Activity 走 Compose setContent，View Binding 已关闭",
        "GameCoreView 以 SurfaceView 自绘，30FPS 渲染线程独占游戏状态",
        "UI 线程经 gameCommands 队列提交命令，帧内 SurfaceHolder 锁中消费"
      ]
    },
    {
      "dot": "violet",
      "title": "状态与数据",
      "items": [
        "17 个 ViewModel + StateFlow 单向数据流，拼图图片加载归 PuzzleImageViewModel",
        "Room v2031 仅注册显式迁移，无破坏性回退",
        "进度统一走 replaceForPlayer() 事务，网络为 OkHttp 直连"
      ]
    },
    {
      "dot": "amber",
      "title": "两条独立进度线",
      "items": [
        "战斗通关直接进下一关，不经过拼图",
        "拼图是设置下的独立十关，按 GameMode.PUZZLE 存档",
        "“继续游戏”是关卡检查点重启，不恢复血量与时间"
      ]
    }
  ]
